<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net7.0;net8.0;net9.0</TargetFrameworks>
        <RootNamespace>Vali_Mediator_Resilience</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Package identity -->
        <PackageId>Vali-Mediator.Resilience</PackageId>
        <Version>1.2.3</Version>
        <Title>Vali-Mediator.Resilience</Title>
        <Product>Vali-Mediator.Resilience</Product>
        <Authors>Felipe Rafael Montenegro Morriberon</Authors>
        <Copyright>Copyright © 2025 Felipe Rafael Montenegro Morriberon. All rights reserved.</Copyright>

        <!-- Repository -->
        <RepositoryUrl>https://github.com/UBF21/Vali-Mediator</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://vali-mediator-docs.netlify.app/docs/resilience/overview</PackageProjectUrl>

        <!-- License -->
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- Discoverability -->
        <PackageTags>resilience;retry;circuit-breaker;timeout;fallback;bulkhead;rate-limiter;hedge;chaos;mediator;cqrs;dotnet;vali</PackageTags>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Source Link / Symbols -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <Description>
            Zero-dependency resilience library for .NET 7/8/9. Provides Retry (with jitter/backoff),
            Circuit Breaker (sliding-window state machine), Timeout (optimistic + pessimistic),
            Fallback, Bulkhead, Rate Limiter (partitioned per-user/IP), Hedge, and Chaos policies via a fluent builder API.
            Attach policies to Vali-Mediator requests via IResiliencePolicyProvider&lt;T&gt; (no class needed),
            with global fallback policy support. No Polly or other external dependencies required.
        </Description>

        <PackageReleaseNotes>
            v1.2.3 — Auto-discovery for IResiliencePolicyProvider&lt;T&gt;:
            - RegisterResiliencePoliciesFromAssemblyContaining&lt;T&gt;(): auto-discovers and registers all policy providers.
            - RegisterResiliencePoliciesFromAssembly(assembly, lifetime): explicit assembly variant.
            Eliminates manual AddResiliencePolicyProvider&lt;T,P&gt;() calls for each provider class.

            v1.2.2 — Bug fix: ResilienceBehavior now caches the resolved ResiliencePolicy per request type using a
            static field (one cache slot per TRequest+TResponse combination). This covers both AddResiliencePolicy&lt;T&gt;
            lambdas and class-based IResiliencePolicyProvider&lt;T&gt; providers. Stateful policies (Circuit Breaker,
            Rate Limiter, Bulkhead, Hedge) now correctly preserve their state across all requests of the same type,
            regardless of behavior lifetime or provider implementation.

            v1.2.1 — Bug fix: DelegateResiliencePolicyProvider now caches the built ResiliencePolicy after the first request,
            matching the behavior of a static provider. Previously the lambda was invoked on every call, causing
            stateful policies (Circuit Breaker, Rate Limiter, Bulkhead, Hedge) to lose their state between requests.

            v1.2.0 — Policy providers &amp; partitioned rate limiting:
            - IResiliencePolicyProvider&lt;TRequest&gt;: declare policies in a separate class, keeping commands clean.
            - services.AddResiliencePolicy&lt;T&gt;(lambda): inline registration without a class.
            - services.AddResiliencePolicyProvider&lt;T,TProvider&gt;(): class-based registration for DI-dependent providers.
            - IGlobalResiliencePolicyProvider / services.AddGlobalResiliencePolicy(): fallback policy for all requests.
            - RateLimiterOptions.PartitionKeyResolver: per-user/IP rate limiting via a key selector func.
            - IResilient marked [Obsolete] — use AddResiliencePolicy&lt;T&gt;() instead.

            v1.1.0 — Package structure: now uses Vali-Mediator as NuGet dependency instead of local ProjectReference.

            v1.0.1 — Documentation: enabled XML documentation file for full IntelliSense support.

            v1.0.0 — Initial release:
            - RetryPolicy: Fixed / Linear / Exponential / ExponentialWithJitter / Custom backoff, per-exception and per-ErrorType conditions, OnRetry callback.
            - CircuitBreakerPolicy: sliding-window failure tracking, Closed → Open → HalfOpen state machine, configurable thresholds, callbacks.
            - TimeoutPolicy: Optimistic (CancellationToken) and Pessimistic (Task.WhenAny) strategies.
            - FallbackPolicy: typed fallback value or factory, conditional activation, OnFallback callback.
            - BulkheadPolicy: semaphore-based concurrency limiter with optional queue, OnRejected callback.
            - ResiliencePolicy: composable fluent builder combining all policies.
            - ResiliencePresets: ForExternalApi, ForDatabase, ForCritical, NoResilience.
            - Vali-Mediator integration: IResilient interface + ResilienceBehavior pipeline.
            - CircuitBreakerRegistry: keyed singleton registry for sharing circuit state across calls.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="logo.png" Condition="Exists('logo.png')">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="README.md" Condition="Exists('README.md')">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Vali-Mediator" Version="2.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

</Project>
